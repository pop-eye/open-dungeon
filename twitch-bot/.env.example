# Open Dungeon — Twitch Bot Configuration
# Copy this file to twitch-bot/.env and fill in the values.
# Never commit .env to git.

# ── Twitch credentials ──────────────────────────────────────────────────────
# Bot account username (create a separate Twitch account for the bot)
TWITCH_BOT_USERNAME=MyBotUsername

# OAuth token for the bot account (prefix "oauth:" is required)
# Get one at: https://twitchapps.com/tmi/
TWITCH_BOT_OAUTH_TOKEN=oauth:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Channel to join (your channel name, without the # prefix)
TWITCH_CHANNEL=YourChannelName

# ── Open Dungeon server ─────────────────────────────────────────────────────
# Base URL of the Open Dungeon server
OPEN_DUNGEON_URL=http://localhost:3000

# Must match STREAM_API_SECRET in the main app's .env.local
STREAM_API_SECRET=change-me-to-something-secret

# ── Voting behaviour ────────────────────────────────────────────────────────
# Seconds the vote window is open (default: 30)
VOTE_WINDOW_SECONDS=30

# Seconds to wait between automatic vote closes before accepting a new vote (default: 10)
VOTE_COOLDOWN_SECONDS=10

# Set to "false" to allow anyone to open a vote with !vote (default: true = mods only)
MOD_ONLY_VOTE_OPEN=true

# ── Direct submit mode ──────────────────────────────────────────────────────
# Set to "true" to let the FIRST viewer command go through without voting.
# Useful for smaller/slower chats. Voting (!vote) still works when enabled.
DIRECT_SUBMIT=false

# Minimum seconds between submissions in direct mode (default: 10)
RATE_LIMIT_SECONDS=10
