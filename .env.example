# Copy to .env.local (or .env.server) and fill in what you use.
# Everything is optional — the app runs fully local with no keys at all.

# --- Text generation: "Connect a server" provider (all optional) ---
# The backend URL, model, and key are entered in-app in the Text Model panel.
# These env vars are only fallbacks for people who prefer not to type a key
# in the UI. For OpenRouter URLs:
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.5-flash
# For any other OpenAI-compatible server that needs a key:
OPENAI_COMPAT_API_KEY=
# Max output tokens per remote turn, plus OpenRouter attribution headers:
OPENROUTER_MAX_TOKENS=16384
OPENROUTER_APP_TITLE=Open Dungeon
OPENROUTER_APP_URL=http://localhost:3000

# --- Text generation: local via Ollama (the default provider) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
LOCAL_TEXT_MAX_TOKENS=4096
# Context window for local turns. Unset = the model's full native window
# (128K-256K). Set a lower cap to bound prefill time on very long stories.
LOCAL_TEXT_CONTEXT=

# --- Image generation (optional) ---
FLUX_WORKER_URL=http://127.0.0.1:7869

# macOS / Apple Silicon (MFLUX/MLX backend) --------------------------------
ULTRA_FAST_IMAGE_GEN_DIR=~/ultra-fast-image-gen
ULTRA_FAST_IMAGE_GEN_PYTHON=~/ultra-fast-image-gen/.venv/bin/python
# Patched MFLUX checkout (made by ultra-fast-image-gen/scripts/setup_mflux_hs.sh).
# Defaults to ~/.cache/ultra-fast-image-gen/mflux — usually leave unset.
MFLUX_DIR=

# Windows / NVIDIA CUDA (sdnq-hs backend via ultra-fast-image-gen) ----------
# The sdnq-hs backend is pure PyTorch and uses --device cuda on Windows
# automatically. No extra config needed — just run setup-windows-images.ps1.
#
# Override the PyTorch device if needed (default: cuda on Windows, mps on Mac):
# SDNQ_DEVICE=cuda
#
# --- Alternative: ComfyUI backend (advanced, opt-in) -----------------------
# Set IMAGE_BACKEND=comfyui to use comfyui_image_server.py instead.
# Requires a separately running ComfyUI instance (see docs/windows.md).
# IMAGE_BACKEND=comfyui
COMFYUI_URL=http://127.0.0.1:8188
# COMFYUI_PYTHON=C:\Python312\python.exe
# Model filenames inside ComfyUI/models/ — must match your actual files.
# Uncensored GGUF encoder is from ponpoke/flux2-klein-4b-uncensored-text-encoder
COMFYUI_UNET_MODEL=flux2-klein-4b-Q4_K_M.gguf
COMFYUI_CLIP1_MODEL=flux2-klein-4b-uncensored-q4_k_m.gguf
COMFYUI_CLIP2_MODEL=clip_l.safetensors
COMFYUI_VAE_MODEL=ae.safetensors

# --- Twitch / stream integration (optional) ---------------------------------
# Shared secret between the app and the Twitch bot. Generate a random string.
STREAM_API_SECRET=

# Base URL the stream/turn route uses to call /api/story internally.
# In production behind a reverse proxy, set this to the public-facing URL.
NEXTAUTH_URL=http://localhost:3000

# Donation webhook (StreamElements / StreamLabs)
DONATION_WEBHOOK_SECRET=
DONATION_MIN_AMOUNT=1
# Limit to a specific currency code, e.g. USD. Leave blank to accept any.
DONATION_CURRENCY=

# --- Storage ---
SQLITE_DB_PATH=

# --- Dev server access from other devices (e.g. phone over Tailscale) ---
# Comma-separated extra hostnames/IPs allowed to reach `next dev`.
ALLOWED_DEV_ORIGINS=
